APP_NAME=Student Test API
APP_ENV=development
DEBUG=true

# PostgreSQL connection string. ``postgres://`` / ``postgresql://`` URLs are
# normalized to the psycopg driver by app.core.config.
#
# On Vercel, set this in Project Settings -> Environment Variables (for all
# environments: Production, Preview, Development), then redeploy. Vercel
# Postgres integrations that only expose POSTGRES_URL / POSTGRES_PRISMA_URL /
# POSTGRES_URL_NON_POOLING are also picked up automatically.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/student_test?sslmode=require

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of allowed browser origins (your frontend URL(s)).
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

PASSWORD_HASH_ALGORITHM=argon2
