# Copy to .env.local and adjust if the backend runs elsewhere.
# Browser -> FastAPI directly (port 8000); the backend must allow this origin
# in CORS_ORIGINS. Use /api/backend to proxy through Next.js instead.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Server-side target for the /api/health rewrite and /api/backend proxy route.
BACKEND_URL=http://127.0.0.1:8000
