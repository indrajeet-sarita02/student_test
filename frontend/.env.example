# Copy to .env.local and adjust if the backend runs elsewhere.
# Browser -> FastAPI directly (port 8000); the backend must allow this origin
# in CORS_ORIGINS. Leave this unset to route through the same-origin Next.js
# proxy at /api/backend (recommended for production - no CORS needed).
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Server-side target for the /api/health rewrite and the /api/backend proxy
# route. On Vercel this defaults to the deployed backend
# (https://student-testapi.vercel.app); set BACKEND_URL to override it.
BACKEND_URL=http://127.0.0.1:8000
